# ── Sajawat® Wholesale (Women & Kids Stitched Clothing Pakistan) ──
PORT=3000
NODE_ENV=development
SITE_URL=https://www.sajawatwholesale.pk

# ── MongoDB Atlas ──
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.00jxnf9.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="sajawat_wholesale"

# ── AWS S3 Bucket for Product Photos & Client Automated Pipeline ──
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="sajawat-wholesale-assets"

# ── Admin PIN ──
ADMIN_PIN="1234"
